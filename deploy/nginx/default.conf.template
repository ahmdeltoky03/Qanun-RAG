# Weighted canary - change the split with:   scripts/canary.sh 10     (0 = rollback, 100 = promote)
# Force a request to the canary (for testing):  curl -H 'X-Canary: always' ...
upstream stable { server api:8000; }
upstream canary { server api-canary:8000; }
# CANARY_RULE is "" (all traffic to stable) or e.g. "10.0% canary;". It cannot be "0%": nginx rejects zero percentages.
split_clients "${request_id}" $weighted_pool {
    ${CANARY_RULE}
    *   stable;
}
map $http_x_canary $pool {
    always   canary;
    never    stable;
    default  $weighted_pool;
}
server {
    listen 80;
    proxy_read_timeout 120s;
    location / {
        proxy_pass http://$pool;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_buffering off;          # keep SSE streaming (/ask/stream) token-by-token
        add_header X-Served-By $pool always;
    }
}
