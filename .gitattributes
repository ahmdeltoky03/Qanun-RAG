# Shell scripts must keep LF endings or their shebang breaks under WSL/Linux
# (a trailing CR turns `#!/usr/bin/env bash` into `bash\r` → "No such file or directory").
*.sh    text eol=lf
*.bash  text eol=lf

# PowerShell scripts are Windows-native: keep CRLF.
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# Source/config: normalize to LF in the repo.
*.py    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf

# Never touch binary assets.
*.png   binary
*.jpg   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
