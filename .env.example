# ════════════════════════════════════════════════════════════════════
# Egyptian Civil Code RAG — Environment Variables
# Copy this file to .env  (never commit .env)
# All variables are optional; defaults run fully offline.
# ════════════════════════════════════════════════════════════════════

# ── Embedding Model ──────────────────────────────────────────────────
# For Ollama (local or via ngrok from Colab):
PRODML_EMBEDDING_PROVIDER=openai
PRODML_EMBEDDING_BASE_URL=http://localhost:11434/v1   # replace with ngrok URL for Colab
PRODML_EMBEDDING_MODEL=bge-m3
PRODML_EMBEDDING_API_KEY=ollama

# ── LLM ──────────────────────────────────────────────────────────────
# For Ollama (local or via ngrok from Colab):
PRODML_LLM_PROVIDER=openai
PRODML_LLM_BASE_URL=http://localhost:11434/v1         # replace with ngrok URL for Colab
PRODML_LLM_MODEL=gpt-oss:20b
PRODML_LLM_API_KEY=ollama

# ── Fallback (fully offline, no models needed) ────────────────────────
# PRODML_EMBEDDING_PROVIDER=hashing
# PRODML_LLM_PROVIDER=fake

# ── Retrieval Tuning ─────────────────────────────────────────────────
# PRODML_MIN_SCORE=0.0       # 0.0 = disabled; raise to 0.4-0.6 to reject OOS
# PRODML_MIN_COVERAGE=0.0    # 0.0 = disabled

# ── Vector Index ─────────────────────────────────────────────────────
# PRODML_INDEX_DIR=data/index

# ── Langfuse Tracing (docker compose --profile tracing up) ───────────
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# ── RAGAS Quality Gate (CI) ───────────────────────────────────────────
# RAGAS_JUDGE_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# ── Grafana ───────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── ngrok (for Colab server — see notebooks/ollama_colab_ngrok.ipynb) ─
# After running the Colab notebook, paste the printed values above.
# Example:
# PRODML_EMBEDDING_BASE_URL=https://abc123.ngrok-free.app/v1
# PRODML_LLM_BASE_URL=https://abc123.ngrok-free.app/v1
