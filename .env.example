# ============================================================
# Qanun-RAG (Egyptian Civil Code) — environment variables
# Copy this file to .env (never commit .env) and paste your
# Cohere API key in the two places marked below. Everything
# else works with these defaults.
#
# This file lists EVERY variable the project reads, by name.
# Active lines are the recommended defaults; commented lines
# are optional knobs shown name-only with their default in the
# trailing comment. No real secret value ever appears here.
# ============================================================

# -- Models: Cohere (the setup this project is developed on) --
QANUN_EMBEDDING_PROVIDER=cohere
QANUN_EMBEDDING_MODEL=embed-v5.0-pro
QANUN_EMBEDDING_API_KEY=paste-your-cohere-key-here
# Stay under the Cohere trial cap of 20 requests/min while ingesting.
QANUN_EMBEDDING_RPM=18

# Chat model through Cohere's OpenAI-compatible endpoint.
QANUN_LLM_PROVIDER=openai
QANUN_LLM_BASE_URL=https://api.cohere.com/compatibility/v1
QANUN_LLM_MODEL=command-r7b-12-2024
QANUN_LLM_API_KEY=paste-your-cohere-key-here
QANUN_LLM_MAX_TOKENS=2048
QANUN_LLM_TIMEOUT_S=120

# Any other OpenAI-compatible endpoint works too (local Ollama, vLLM, a tunnel):
# QANUN_LLM_BASE_URL=http://your-host:11434/v1
# QANUN_LLM_MODEL=qwen2.5:7b-instruct
# QANUN_LLM_API_KEY=ollama

# -- Offline fallback (no key, no network, deterministic) ----
# QANUN_EMBEDDING_PROVIDER=hashing
# QANUN_LLM_PROVIDER=fake

# -- Data & vector index -------------------------------------
# QANUN_CORPUS_PATH=data/processed/civil_code.json
# QANUN_INDEX_DIR=data/index
# QANUN_QDRANT_URL=                      # unset = embedded local Qdrant; set to use a Qdrant server
# QANUN_COLLECTION=civil_code

# -- Chunking -------------------------------------------------
# QANUN_CHUNK_SIZE=300
# QANUN_CHUNK_OVERLAP=60

# -- Embeddings (extra knobs) ---------------------------------
# QANUN_EMBEDDING_DIM=512                # only used by the "hashing" provider
# QANUN_EMBEDDING_BASE_URL=              # only for openai-compatible embedding servers

# -- Retrieval tuning ----------------------------------------
# QANUN_TOP_K=4
# QANUN_CANDIDATE_K=16
# QANUN_MIN_SCORE=0.0                    # 0.0 = disabled; raise to 0.4-0.6 to reject out-of-scope harder
# QANUN_MIN_COVERAGE=0.25                # min idf-weighted share of query terms found in best article
# QANUN_DENSE_WEIGHT=0.5                 # RRF weight of dense ranking (BM25 gets 1 - this)
# QANUN_RERANK=lexical                   # none | lexical | cross-encoder
# QANUN_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3   # only when QANUN_RERANK=cross-encoder

# -- Generation (extra knobs) ---------------------------------
# QANUN_LLM_TEMPERATURE=0.0
# QANUN_LLM_KEEP_ALIVE=                  # Ollama only: keep model resident in VRAM

# -- Guardrails ------------------------------------------------
# QANUN_MAX_QUESTION_CHARS=1000
# QANUN_PII_MODE=mask                    # mask | block | off

# -- Answer cache ----------------------------------------------
# QANUN_ANSWER_CACHE=true
# QANUN_ANSWER_CACHE_MAX=256
# QANUN_ANSWER_CACHE_TTL_S=3600

# -- CORS: origins allowed to call the API (the Next.js UI) --
QANUN_CORS_ORIGINS=http://localhost:3000

# -- Observability / eval --------------------------------------
# QANUN_EVAL_REPORT_PATH=reports/latest_eval.json
# QANUN_DRIFT_BASELINE_PATH=data/index/query_baseline.json
# QANUN_DRIFT_WINDOW=200
# QANUN_RELEASE=stable                   # stable | canary (shown in /health)

# -- Langfuse tracing (docker compose --profile tracing up) ---
# The QANUN_ trio is what the API signs traces with. The unprefixed pair is what
# the Langfuse container bootstraps its project with on an EMPTY database volume.
# Keep both pairs identical, and keep the host on 3100 (3000 belongs to the UI).
QANUN_LANGFUSE_PUBLIC_KEY=pk-lf-local
QANUN_LANGFUSE_SECRET_KEY=sk-lf-local
QANUN_LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# -- Grafana ----------------------------------------------------
GRAFANA_PASSWORD=admin

# -- RAGAS quality gate (only for qanun-eval --mode ragas) ------
# Read straight from the environment (not via .env prefix). OPENAI_API_KEY may be
# a dummy when pointing RAGAS_BASE_URL at a self-hosted OpenAI-compatible judge.
# RAGAS_JUDGE_MODEL=gpt-4o-mini
# RAGAS_BASE_URL=
# RAGAS_EMBED_MODEL=text-embedding-3-small
# RAGAS_MAX_WORKERS=4
# OPENAI_API_KEY=
