# ════════════════════════════════════════════════════════════════════
# Qanun-RAG (Egyptian Civil Code) — Environment Variables
# Copy this file to .env  (never commit .env)
# All variables are optional; the offline fallback at the bottom runs with no models at all.
# ════════════════════════════════════════════════════════════════════

# ── Real models: Ollama on Colab, exposed through an ngrok tunnel ─────
# On Colab the notebook serves Ollama on port 8000 and tunnels it with pyngrok:
#     OLLAMA_HOST=0.0.0.0:8000 OLLAMA_ORIGIN=* ollama serve
#     ngrok.connect("8000")   # → https://XXXX-....ngrok-free.app
# Paste that public URL below (append /v1 — Ollama's OpenAI-compatible path).
# ⚠️ Free ngrok URLs change on every tunnel restart; after changing the
#    embedding model/URL, rebuild the index:  qanun-ingest
NGROK_URL=https://YOUR-TUNNEL.ngrok-free.app

# ── Embedding Model ──────────────────────────────────────────────────
QANUN_EMBEDDING_PROVIDER=openai
QANUN_EMBEDDING_BASE_URL=https://YOUR-TUNNEL.ngrok-free.app/v1
QANUN_EMBEDDING_MODEL=bge-m3
QANUN_EMBEDDING_API_KEY=ollama

# ── LLM ──────────────────────────────────────────────────────────────
QANUN_LLM_PROVIDER=openai
QANUN_LLM_BASE_URL=https://YOUR-TUNNEL.ngrok-free.app/v1
QANUN_LLM_MODEL=qwen2.5:7b-instruct
QANUN_LLM_API_KEY=ollama
# qwen2.5:7b-instruct is a fast non-reasoning model (answers immediately, low latency).
# If you switch to a reasoning model (e.g. gpt-oss:20b) it thinks first and cold-loads
# slowly — raise these or you'll get an empty answer / HTTP 500 on the first call:
QANUN_LLM_MAX_TOKENS=2048
QANUN_LLM_TIMEOUT_S=240
# Ollama only: keep the model in VRAM so post-idle calls stay fast (-1 = never unload).
QANUN_LLM_KEEP_ALIVE=-1

# ── Offline fallback (no tunnel, no GPU, fully deterministic) ────────
# QANUN_EMBEDDING_PROVIDER=hashing
# QANUN_LLM_PROVIDER=fake

# ── Retrieval Tuning ─────────────────────────────────────────────────
# QANUN_MIN_SCORE=0.0       # 0.0 = disabled; raise to 0.4-0.6 to reject out-of-scope questions
# QANUN_MIN_COVERAGE=0.25   # min idf-weighted share of query terms found in the best article

# ── CORS (origins allowed to call the API — the Next.js UI) ──────────
# QANUN_CORS_ORIGINS=http://localhost:3000,https://qanun.vercel.app

# ── Vector Index ─────────────────────────────────────────────────────
# QANUN_INDEX_DIR=data/index

# ── Langfuse Tracing (docker compose --profile tracing up) ───────────
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local

# ── RAGAS Quality Gate (CI) ───────────────────────────────────────────
# RAGAS_JUDGE_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# ── Grafana ───────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
